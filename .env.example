# Banco e fila locais
POSTGRES_DB=inbot
POSTGRES_USER=inbot
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# Endereços para executar API e Worker fora do Docker Compose.
# Dentro do Compose, os hosts recebem os nomes dos serviços automaticamente.
DATABASE_URL=postgresql://inbot:local-development-only@localhost:5432/inbot
REDIS_URL=redis://localhost:6379

# Serviços HTTP
API_PORT=3000
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Processamento assíncrono e integração de feriados
BRASIL_API_TIMEOUT_MS=5000
SLA_RETRY_ATTEMPTS=3
SLA_RETRY_BACKOFF_MS=1000
HOLIDAY_CACHE_TTL_SECONDS=86400
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=30
TICKET_POLL_INTERVAL_MS=3000
